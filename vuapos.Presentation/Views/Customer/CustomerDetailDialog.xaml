<Window
    x:Class="vuapos.Presentation.Views.Customer.CustomerDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Customer Details">

    <Grid Padding="20">
        <StackPanel>
            <TextBlock Text="Customer Details" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Name:" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Bind Customer.Name, Mode=OneWay}" Margin="0,0,0,10"/>

            <TextBlock Text="Phone:" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Bind Customer.Phone, Mode=OneWay}" Margin="0,0,0,10"/>

            <TextBlock Text="Email:" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Bind Customer.Email, Mode=OneWay}" Margin="0,0,0,10"/>

            <TextBlock Text="Points:" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Bind Customer.Point, Mode=OneWay}" Margin="0,0,0,20"/>

            <Button Content="Close" Click="OnCloseClicked" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>
