<UserControl
    x:Class="vuapos.Presentation.Views.Order.OrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:vuapos.Presentation.Views.Order"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Button positioned on the left -->
            <Button Grid.Column="0"
            Content="Create Order"
            VerticalAlignment="Center"
            Margin="0,0,10,0"
            Click="CreateOrder_Click"/>

            <!-- TextBox positioned on the right -->
            <TextBox Grid.Column="2"
             Width="200"
             PlaceholderText="Search Order..."
             VerticalAlignment="Center"
             Margin="0,0,0,0"/>
        </Grid>

        <Grid Grid.Row="1"
      Background="#F5F5F5"
      Margin="0,15,0,0"
      Padding="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <!-- Fixed width for ID column -->
                <ColumnDefinition Width="100"/>
                <!-- Customer Name takes remaining space -->
                <ColumnDefinition Width="200"/>
                <!-- Phone column -->
                <ColumnDefinition Width="180"/>
                <!-- Email column -->
                <ColumnDefinition Width="100"/>
                <!-- Date column -->
                <ColumnDefinition Width="80"/>
                <!-- Total column -->
                <ColumnDefinition Width="100"/>
                <!-- Status column -->
                <ColumnDefinition Width="*"/>
                <!-- Actions column -->
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" FontWeight="Bold" Text="#" VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock Grid.Column="1" FontWeight="Bold" Text="Customer Name" VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock Grid.Column="2" FontWeight="Bold" Text="Phone" VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock Grid.Column="3" FontWeight="Bold" Text="Email" VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock Grid.Column="4" FontWeight="Bold" Text="Date" VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock Grid.Column="5" FontWeight="Bold" Text="Total" VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock Grid.Column="6" FontWeight="Bold" Text="Status" VerticalAlignment="Center" Margin="5,0"/>
            <TextBlock Grid.Column="7" FontWeight="Bold" Text="Actions" VerticalAlignment="Center" Margin="5,0"/>
        </Grid>

        <ListView Grid.Row="2"
          ItemsSource="{Binding Orders}"
          SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
          SelectionMode="Single"
          Padding="0"
          Background="Transparent"
          BorderThickness="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="48"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Grid x:Name="ContentBorder"
                              Background="{TemplateBinding Background}"
                              BorderThickness="0,0,0,1"
                              BorderBrush="#EEEEEE">
                                    <ContentPresenter Content="{TemplateBinding Content}"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <!-- Fixed width for ID column -->
                            <ColumnDefinition Width="100"/>
                            <!-- Customer Name takes remaining space -->
                            <ColumnDefinition Width="200"/>
                            <!-- Phone column -->
                            <ColumnDefinition Width="180"/>
                            <!-- Email column -->
                            <ColumnDefinition Width="100"/>
                            <!-- Date column -->
                            <ColumnDefinition Width="80"/>
                            <!-- Total column -->
                            <ColumnDefinition Width="100"/>
                            <!-- Status column -->
                            <ColumnDefinition Width="*"/>
                            <!-- Actions column -->
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Order_Id}" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding CustomerName}" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding CustomerPhone}" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding CustomerEmail}" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBlock Grid.Column="4" Text="{Binding OrderDate}" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBlock Grid.Column="5" Text="{Binding TotalAmount}" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBlock Grid.Column="6" Text="{Binding OrderStatus}" VerticalAlignment="Center" Margin="5,0"/>

                        <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,0">
                            <Button Content="Details"
                            Tag="{Binding}"
                            Click="ViewOrder_Click"
                            Margin="0,0,10,0"/>

                            <Button Content="Cancel"
                            Background="Red"
                            Foreground="White"
                            Tag="{Binding}"
                            Click="ViewOrder_Click"
                            Margin="0,0,10,0"/>

                            <Button Content="Send mail"
                            Background="#0078D7"
                            Foreground="White"
                            Tag="{Binding}"
                            Click="ViewOrder_Click"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
    </Grid>
</UserControl>