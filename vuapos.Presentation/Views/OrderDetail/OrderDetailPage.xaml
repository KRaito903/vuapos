<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="vuapos.Presentation.Views.OrderDetail.OrderDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:vuapos.Presentation.Views.OrderDetail"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:vuapos.Presentation.ViewModels"
    mc:Ignorable="d"
    Title="OrderDetailPage">

    <Window.Resources>
        <vm: x:Key="OrderVM" />
        <vm:ProductViewModel x:Key="ProductVM" />
    </Window.Resources>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Search Product Section -->
            <RowDefinition Height="Auto"/>
            <!-- Order Information Section -->
            <RowDefinition Height="*"/>
            <!-- Order Details (Product List) Section -->
            <RowDefinition Height="Auto"/>
            <!-- Footer with Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Create New Order" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8"/>
            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- Product Search Section -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Search Product" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" 
                     Text="{x:Bind ViewModel.ProductSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     PlaceholderText="Search by product name, code or category..." 
                     Margin="0,0,12,0"/>

                <Button Grid.Column="1" Content="Search" Command="{x:Bind ViewModel.SearchProductCommand}" Padding="12,4"/>
            </Grid>

            <!-- Search Results -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView Grid.Row="0"
                      ItemsSource="{x:Bind ViewModel.ProductSearchResults, Mode=OneWay}" 
                      SelectedItem="{x:Bind ViewModel.SelectedProduct, Mode=TwoWay}"
                      SelectionMode="Single"
                      Height="200"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="8,4"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Product">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind ProductId}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ProductName}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind Category}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind UnitPrice, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind StockQuantity}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.Header>
                        <Grid Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Product Name" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Category" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Unit Price" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Stock" FontWeight="SemiBold"/>
                        </Grid>
                    </ListView.Header>
                </ListView>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Quantity:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <NumberBox Value="{x:Bind ViewModel.NewItemQuantity, Mode=TwoWay}" 
                              SpinButtonPlacementMode="Compact"
                              Minimum="1"
                              SmallChange="1"
                              Width="100" 
                              Margin="0,0,12,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" 
                        Content="Add to Order" 
                        Command="{x:Bind ViewModel.AddToOrderCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="12,4"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Order Information Section -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Order Information" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column - Customer Information -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Customer Information" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Customer Name:" Margin="0,8,0,4"/>
                    <TextBox Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay}" Margin="0,0,0,12"/>

                    <TextBlock Text="Phone Number:" Margin="0,0,0,4"/>
                    <TextBox Text="{x:Bind ViewModel.CustomerPhone, Mode=TwoWay}" Margin="0,0,0,12"/>

                    <TextBlock Text="Email:" Margin="0,0,0,4"/>
                    <TextBox Text="{x:Bind ViewModel.CustomerEmail, Mode=TwoWay}" Margin="0,0,0,12"/>

                    <TextBlock Text="Address:" Margin="0,0,0,4"/>
                    <TextBox Text="{x:Bind ViewModel.CustomerAddress, Mode=TwoWay}" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         Height="80" 
                         Margin="0,0,0,12"/>
                </StackPanel>

                <!-- Right Column - Order Settings -->
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Order Settings" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Order Date:" Margin="0,8,0,4"/>
                    <CalendarDatePicker Date="{x:Bind ViewModel.OrderDate, Mode=TwoWay}" 
                                   HorizontalAlignment="Stretch"
                                   Margin="0,0,0,12"/>

                    <TextBlock Text="Payment Method:" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.PaymentMethods}" 
                          SelectedItem="{x:Bind ViewModel.SelectedPaymentMethod, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,0,12"/>

                    <TextBlock Text="Order Notes:" Margin="0,0,0,4"/>
                    <TextBox Text="{x:Bind ViewModel.OrderNotes, Mode=TwoWay}" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"
                         Height="100"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Order Details (Product List) Section -->
        <Grid Grid.Row="3" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Order Details" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>

            <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.OrderItems, Mode=OneWay}"
                  HorizontalContentAlignment="Stretch"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="8,4"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:OrderItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind ProductId}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ProductName}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind UnitPrice, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center"/>

                            <NumberBox Grid.Column="3" 
                                  Value="{x:Bind Quantity, Mode=TwoWay}" 
                                  Minimum="1"
                                  SpinButtonPlacementMode="Compact"
                                  VerticalAlignment="Center"/>

                            <NumberBox Grid.Column="4" 
                                  Value="{x:Bind Discount, Mode=TwoWay}" 
                                  Minimum="0"
                                  Maximum="1"
                                  SmallChange="0.05"
                                  NumberFormatter="{StaticResource PercentFormatter}"
                                  VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="5" Text="{x:Bind LineTotal, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center"/>

                            <Button Grid.Column="6" 
                                Content="Remove" 
                                Command="{x:Bind DataContext.RemoveItemCommand, ElementName=OrderItemsList}"
                                CommandParameter="{x:Bind}"
                                Foreground="White"
                                Background="{ThemeResource SystemFillColorCriticalBrush}"
                                Padding="8,4"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Header>
                    <Grid Padding="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Prod ID" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Product Name" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Unit Price" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Quantity" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Discount" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="Total" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="6" Text="Actions" FontWeight="SemiBold"/>
                    </Grid>
                </ListView.Header>
            </ListView>

            <!-- Order Summary -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal:" HorizontalAlignment="Right" Margin="0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Subtotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" Margin="20,6,0,6" MinWidth="120"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tax (10%):" HorizontalAlignment="Right" Margin="0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Tax, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" Margin="20,6,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Shipping:" HorizontalAlignment="Right" Margin="0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ShippingCost, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" Margin="20,6,0,6"/>

                        <Rectangle Grid.Row="3" Grid.ColumnSpan="2" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,6"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Total:" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,6"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.TotalAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" HorizontalAlignment="Right" Margin="20,6,0,6"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Footer with Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" Padding="16,8" Margin="0,0,12,0"/>
            <Button Grid.Column="2" 
                Content="Save Order" 
                Command="{x:Bind ViewModel.SaveOrderCommand}" 
                Style="{StaticResource AccentButtonStyle}"
                Padding="16,8"/>
        </Grid>
    </Grid>
</Window>
